[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Project/菜单.gd" id="1_menu"]

[node name="菜单" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="背景" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.05, 0.045, 1)
mouse_filter = 2

[node name="菜单面板" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -210.0
offset_right = 180.0
offset_bottom = 210.0
theme_override_constants/separation = 18

[node name="标题" type="Label" parent="菜单面板"]
layout_mode = 2
theme_override_colors/font_color = Color(0.82, 0.9, 0.82, 1)
theme_override_font_sizes/font_size = 42
text = "SURVIVAL"
horizontal_alignment = 1

[node name="副标题" type="Label" parent="菜单面板"]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.6, 0.5, 1)
theme_override_font_sizes/font_size = 16
text = "一个新的世界正在等待"
horizontal_alignment = 1

[node name="间隔" type="Control" parent="菜单面板"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2

[node name="按钮组" type="VBoxContainer" parent="菜单面板"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="新游戏按钮" type="Button" parent="菜单面板/按钮组"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "新游戏"

[node name="继续游戏按钮" type="Button" parent="菜单面板/按钮组"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "继续游戏"

[node name="设置按钮" type="Button" parent="菜单面板/按钮组"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "设置"

[node name="退出按钮" type="Button" parent="菜单面板/按钮组"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "退出游戏"

[node name="操作提示" type="Label" parent="菜单面板"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.48, 0.42, 1)
text = "WASD 移动 · 鼠标瞄准"
horizontal_alignment = 1

[node name="设置面板" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -220.0
offset_top = -150.0
offset_right = 220.0
offset_bottom = 150.0

[node name="设置内容" type="VBoxContainer" parent="设置面板"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="标题" type="Label" parent="设置面板/设置内容"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "设置"
horizontal_alignment = 1

[node name="分辨率" type="Label" parent="设置面板/设置内容"]
layout_mode = 2
text = "分辨率    1920 × 1080"
horizontal_alignment = 1

[node name="音量行" type="HBoxContainer" parent="设置面板/设置内容"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="音量减少按钮" type="Button" parent="设置面板/设置内容/音量行"]
custom_minimum_size = Vector2(42, 42)
layout_mode = 2
text = "-"

[node name="音量滑块" type="HSlider" parent="设置面板/设置内容/音量行"]
custom_minimum_size = Vector2(210, 42)
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 10.0
step = 1.0

[node name="音量增加按钮" type="Button" parent="设置面板/设置内容/音量行"]
custom_minimum_size = Vector2(42, 42)
layout_mode = 2
text = "+"

[node name="音量数值" type="Label" parent="设置面板/设置内容/音量行"]
custom_minimum_size = Vector2(52, 42)
layout_mode = 2
vertical_alignment = 1
text = "10 / 10"

[node name="返回按钮" type="Button" parent="设置面板/设置内容"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
text = "返回"

[connection signal="pressed" from="菜单面板/按钮组/新游戏按钮" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="菜单面板/按钮组/继续游戏按钮" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="菜单面板/按钮组/设置按钮" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="菜单面板/按钮组/退出按钮" to="." method="_on_quit_pressed"]
[connection signal="pressed" from="设置面板/设置内容/返回按钮" to="." method="_on_close_settings_pressed"]
[connection signal="value_changed" from="设置面板/设置内容/音量行/音量滑块" to="." method="_on_volume_changed"]
[connection signal="pressed" from="设置面板/设置内容/音量行/音量减少按钮" to="." method="_on_volume_decreased"]
[connection signal="pressed" from="设置面板/设置内容/音量行/音量增加按钮" to="." method="_on_volume_increased"]
