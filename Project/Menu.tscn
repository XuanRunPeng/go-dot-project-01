[connection signal="pressed" from="MenuPanel/Buttons/NewGameButton" to="." method="_on_new_game_pressed"]
[connection signal="pressed" from="MenuPanel/Buttons/ContinueButton" to="." method="_on_continue_pressed"]
[connection signal="pressed" from="MenuPanel/Buttons/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="MenuPanel/Buttons/QuitButton" to="." method="_on_quit_pressed"]
