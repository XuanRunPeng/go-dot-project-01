layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "新游戏"

[node name="ContinueButton" type="Button" parent="MenuPanel/Buttons"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "继续游戏"

[node name="SettingsButton" type="Button" parent="MenuPanel/Buttons"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "设置"

[node name="QuitButton" type="Button" parent="MenuPanel/Buttons"]
custom_minimum_size = Vector2(360, 52)
layout_mode = 2
theme_override_font_sizes/font_size = 20
