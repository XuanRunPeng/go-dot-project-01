[connection signal="pressed" from="SettingsPanel/SettingsBox/VolumeRow/DecreaseButton" to="." method="_on_volume_decreased"]
[connection signal="pressed" from="SettingsPanel/SettingsBox/VolumeRow/IncreaseButton" to="." method="_on_volume_increased"]
